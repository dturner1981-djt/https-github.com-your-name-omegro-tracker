  "commentary": [
    {
      "bu": "tlm",
      "metric": "net_revenue",
      "period": "2026-08",
      "text": "Net revenue is $52k below forecast, primarily due to a revenue recognition reassessment for Project Hawk VF3. Revenue previously forecast as Professional Services in the QSR (Lot 3 software rewrite) was determined to be non-distinct and is therefore being recognised as part of the SaaS bundle over the remaining contract term. This creates a permanent Professional Services revenue shortfall versus QSR. Full quarter update is a gap of $122k driven by the revenue recognition assessment noted with the reminder relating to timing difference on PS project implementation, being pushed back to Q4.",
      "source": "omegro_monthly",
      "author": null
    },
    {
      "bu": "tlm",
      "metric": "net_revenue",
      "period": "2026-08",
      "text": "No additional material upsides or risks are currently anticipated; however, revenue remains subject to timing of project delivery, contract activity and customer requirements.",
      "source": "omegro_monthly",
      "author": null
    },
    {
      "bu": "tlm",
      "metric": "opex",
      "period": "2026-08",
      "text": "Operating expenses were \u00a342k/$68k above QSR, primarily due to AI-related costs (\u00a320k AI token usage) and \u00a322k related to AI Accelerator and Quadrants recharges not included in QSR. Q3 overspend vs QSR of $274k primarily driven by restructuring costs of \u00a3150k/$200k not included in QSR plus QTD overspends on AI tokens and Quadrants/AI Accelerator costs.",
      "source": "omegro_monthly",
      "author": null
    },
    {
      "bu": "grosvenor",
      "metric": "net_revenue",
      "period": "2026-08",
      "text": "Variance below reporting threshold. Classified temporary favourable; outlook adjusted for a September net revenue risk. Small net revenue risk due to delayed projects in September.",
      "source": "omegro_monthly",
      "author": null
    },
    {
      "bu": "grosvenor",
      "metric": "opex",
      "period": "2026-08",
      "text": "Variance below reporting threshold. Classified permanent favourable; outlook adjusted. Nothing further has been included in the projection.",
